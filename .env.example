# ========================================================
# PrintFlow SaaS - Environment Configuration
# ========================================================

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database (PostgreSQL)
# For Supabase / Neon / Docker / Local PostgreSQL:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/printflow?schema=public"

# Authentication & Session
NEXTAUTH_SECRET="printflow_dev_secret_key_change_me_in_production_32char"
NEXTAUTH_URL="http://localhost:3000"

# Storage Configuration (local | r2 | s3)
STORAGE_PROVIDER="local"
LOCAL_UPLOAD_DIR="./uploads"

# Cloudflare R2 / AWS S3 (for Production)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="printflow-temp-files"
R2_PUBLIC_URL=""

# Payment Gateways (Razorpay / Cashfree)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_test_secret_placeholder"
RAZORPAY_WEBHOOK_SECRET="rzp_whsec_placeholder"

CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""

# Print Agent Pairing Default Salt
AGENT_AUTH_SALT="printflow_agent_secure_token"
